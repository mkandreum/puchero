# Base de datos (docker compose)
POSTGRES_USER=puchero
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=puchero

# Para desarrollo local fuera de Docker
DATABASE_URL=postgresql://puchero:cambia-esta-contraseña@localhost:5432/puchero?schema=public

# IA (misma clave que VoltBody Powered). Sin clave, la app usa recetas locales.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# Zona horaria para rachas y "hoy"
APP_TZ=Europe/Madrid
PORT=3000
