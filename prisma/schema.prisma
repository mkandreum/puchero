generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Usuario anónimo identificado por dispositivo (x-device-id)
model User {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dislikes  String[] @default([])
  goal      String   @default("verde")
  meals     Meal[]
}

model Meal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  tagline     String   @default("")
  tip         String   @default("")
  steps       String[]
  ingredients String[]
  kcal        Int
  protein     Int
  minutes     Int
  slot        String
  source      String   @default("local")
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}
