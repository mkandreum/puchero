generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Cuenta con email y contraseña. Los usuarios anónimos antiguos (id = id de dispositivo)
/// se convierten en cuenta al registrarse desde ese mismo dispositivo y conservan su racha.
model User {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  email        String?  @unique
  name         String   @default("")
  passwordHash String?
  /// Subirla invalida todas las sesiones (cambio de contraseña, "cerrar sesión en todos")
  tokenVersion Int      @default(0)
  dislikes     String[] @default([])
  allergies    String[] @default([])
  goal         String   @default("verde")
  skill        String   @default("apano")
  slots        String[] @default(["desayuno", "comida", "cena"])
  onboarded    Boolean  @default(false)
  meals        Meal[]
}

model Meal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  tagline     String   @default("")
  tip         String   @default("")
  steps       String[]
  ingredients String[]
  kcal        Int
  protein     Int
  minutes     Int
  slot        String
  source      String   @default("local")
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}
