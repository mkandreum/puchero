{
  "name": "puchero",
  "private": true,
  "version": "1.0.0",
  "description": "PUCHERO: come bien sin drama. Súper, cazuela y recetas con IA.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "node scripts/build-client.mjs --watch",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "build": "node scripts/build-client.mjs && node scripts/build-server.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@google/genai": "^1.43.0",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
